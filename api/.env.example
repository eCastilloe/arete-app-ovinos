# Copia este archivo como .env y llena los valores.
# NUNCA subas .env al repo: ya está en .gitignore.
# En la nube, estas variables se configuran en Render (Environment).

# Conexión a Neon con pooler, rol arete_api (sin permiso DELETE). La usa la API.
DATABASE_URL=postgresql+psycopg://arete_api:<password>@<host>/<database>?sslmode=require

# Conexión con el rol dueño de las tablas. Solo la usan las migraciones de Alembic.
DATABASE_URL_MIGRACIONES=postgresql+psycopg://<owner>:<password>@<host>/<database>?sslmode=require

# Secreto para firmar los JWT. Genera uno largo y aleatorio, por ejemplo:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=<secreto-aleatorio>

# Supabase Storage (fotos de evidencia, bucket privado).
SUPABASE_URL=https://<project-id>.supabase.co
# La service key solo vive en Render y en tu .env local. Nunca en la app ni en el repo.
SUPABASE_SERVICE_KEY=<service-key>
BUCKET_FOTOS=evidencias
