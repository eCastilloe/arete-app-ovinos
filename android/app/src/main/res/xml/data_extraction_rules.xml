<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/session.preferences_pb" />
        <!-- Avisos ya mostrados (HU-39): igual que la sesión, se quedan en este dispositivo. -->
        <exclude domain="sharedpref" path="avisos.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/session.preferences_pb" />
        <exclude domain="sharedpref" path="avisos.xml" />
    </device-transfer>
</data-extraction-rules>
